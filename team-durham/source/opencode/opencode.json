{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/kimi-k2.6:cloud",
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": true
    },
    "allura-brain": {
      "type": "remote",
      "url": "http://localhost:5888/mcp",
      "oauth": false,
      "enabled": true
    },
    "libreoffice": {
      "type": "local",
      "command": [
        "/home/ronin704/Projects/Brand maker/.venv/bin/fastmcp",
        "run",
        "/home/ronin704/tools/mcp-libre/libreoffice_mcp_server.py"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "penpot": {
      "type": "remote",
      "url": "http://localhost:4401/mcp",
      "enabled": true,
      "timeout": 60000
    },
    "open-design": {
      "type": "local",
      "command": [
        "/home/ronin704/.nvm/versions/node/v24.14.0/bin/node",
        "/media/ronin704/Games/Projects/open-design/apps/daemon/dist/cli.js",
        "mcp",
        "--daemon-url",
        "http://127.0.0.1:43191"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow",
    "web_fetch": "allow",
    "skill": {
      "pr-review": "allow",
      "internal-*": "allow",
      "experimental-*": "allow"
    }
  },
  "skills": {
    "paths": [
      "/home/ronin704/Projects/design/brand-maker/.opencode/skills",
      "/home/ronin704/Projects/design/brand-maker/.claude/skills",
      "/home/ronin704/Projects/design/brand-maker/.agents/skills"
    ]
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
